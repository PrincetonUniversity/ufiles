#!/bin/bash
#
# ============================================================================
# UFILES build environment
#
# PPPL Flux
# Intel oneAPI 2023.2.0
# OpenMPI 4.1.6
#
# Compilers:
#   Fortran : ifort
#   C       : icx
#   C++     : icpx
#
# Optimized for TRANSP shared-library development.
#
# Usage:
#
#   source env_intel_2023.sh
#
# ============================================================================


# ============================================================================
# Modules
# ============================================================================

module purge

module load git

module load intel/2023.2.0

module load openmpi/4.1.6-intel-2023.2.0-f6nrfjk


# ============================================================================
# Compilers
# ============================================================================

export FC=ifort
export F77=ifort
export F90=ifort

export CC=icx
export CXX=icpx
export CX=icpx

export COMPILER=icc

export FORTRAN_VARIANT=Intel
export INTEL_CXXLIB_ICC=1


# ============================================================================
# MPI compilers
# ============================================================================

export MPICC=mpicc
export MPICXX=mpicxx

export MPIFC=mpif90
export MPIF77=mpif77
export MPIF90=mpif90


# ============================================================================
# Intel runtime
# ============================================================================

export FLIBROOT="/opt/hpc/compiler/intel/2023.2.0/compiler/2023.2.0/linux/compiler/lib/intel64_lin"


# ============================================================================
# GNU C++ runtime
#
# Intel icpx uses the GNU C++ standard library on Linux.
# ============================================================================

GCC_PATH="$(gcc -print-file-name=libstdc++.so)"

GCC_DIR="$(dirname "${GCC_PATH}")"

export CPP_TRAILER="\
-L${GCC_DIR} \
-lstdc++"


# ============================================================================
# HDF5
# ============================================================================

module load openmpi-4.1.6/intel-2023.2.0/hdf5/1.14.6-c77my


# ============================================================================
# NetCDF
# ============================================================================

module load openmpi-4.1.6/intel-2023.2.0/netcdf-c/4.9.2-qpqoj

module load openmpi-4.1.6/intel-2023.2.0/netcdf-cxx4/4.3.1-k3jqv

module load openmpi-4.1.6/intel-2023.2.0/netcdf-fortran/4.6.1-bfskx


# ============================================================================
# SZIP
# ============================================================================

module load libszip/2.1.1-intel-2023.2.0-bo3cg


# ============================================================================
# NetCDF
# ============================================================================

export NETCDF_FORTRAN_HOME="${NETCDF_F_HOME}"

export NETCDF_MODDIR="${NETCDF_F_HOME}/include"

export I_NETCDF="\
-I${NETCDF_F_HOME}/include \
-I${NETCDF_C_HOME}/include"

export L_NETCDF="\
-Wl,-rpath,${NETCDF_F_HOME}/lib \
-L${NETCDF_F_HOME}/lib \
-lnetcdff \
-Wl,-rpath,${NETCDF_C_HOME}/lib64 \
-L${NETCDF_C_HOME}/lib64 \
-lnetcdf"


# ============================================================================
# HDF5
# ============================================================================

if [[ -n "${HDF5_HOME:-}" ]]; then

    export I_HDF5="-I${HDF5_HOME}/include"

    export L_HDF5="\
-Wl,-rpath,${HDF5_HOME}/lib \
-L${HDF5_HOME}/lib \
-lhdf5_fortran \
-lhdf5"

else

    export I_HDF5=""
    export L_HDF5=""

fi


# ============================================================================
# SZIP
# ============================================================================

if [[ -n "${SZIP_HOME:-}" ]]; then

    export I_SZIP="-I${SZIP_HOME}/include"

    export L_SZIP="\
-L${SZIP_HOME}/lib \
-lsz"

else

    export I_SZIP=""
    export L_SZIP=""

fi


# ============================================================================
# PSPLINE
# ============================================================================

#module load pspline/2.0.1-build-20250811-intel-2023.2.0
export PSPLINE_HOME="/p/pshare/transp/opt/pspline/2.4.0/icc/2023"
export L_PSPLINE="\
-Wl,-rpath,${PSPLINE_HOME}/lib \
-L${PSPLINE_HOME}/lib \
-lpspline"


# ============================================================================
# MDSplus
# ============================================================================

module load mdsplus/7.132.0-intel-2023.2.0

export MDSPLUS_DIR="${MDSPLUS_ROOT}"

export L_MDSPLUS="\
-Wl,-rpath,${MDSPLUS_DIR}/lib \
-L${MDSPLUS_DIR}/lib \
-lMdsLib"


# ============================================================================
# MDSplus TRANSP server configuration
# ============================================================================

export TRANSPGRID_SERVER=transpgrid.pppl.gov
export MDS_TRANSP_SERVER=transpgrid.pppl.gov
export MDS_TRANSP_RETRY=3


# ============================================================================
# Build configuration
# ============================================================================

export MAKE_SO=1

export DEBUG=0


# ============================================================================
# Intel 2023 optimization
#
# Use portable optimization for Flux AMD Zen 4 processors.
#
# -O2                Production optimization
# -fp-model precise  Preserve floating-point accuracy
# -fPIC              Position-independent code
# -g                 Debugging symbols
# -traceback         Fortran traceback information
#
# Do not use:
#
#   -axCORE-AVX512
#   -xCORE-AVX2
#
# ============================================================================

export FFLAGS_OPT="\
-O2 \
-g \
-fPIC \
-fp-model precise \
-traceback"

export FFLAGS_DBG="\
-O0 \
-g \
-fPIC \
-traceback \
-check bounds \
-check pointers \
-fpe0"


# ============================================================================
# Select Fortran flags
# ============================================================================

if [[ "${DEBUG}" == "0" ]]; then
    export FFLAGS="${FFLAGS_OPT}"
else
    export FFLAGS="${FFLAGS_DBG}"
fi

export FCFLAGS="${FFLAGS}"


# ============================================================================
# C compiler flags
# ============================================================================

export CFLAGS_OPT="\
-O2 \
-g \
-fPIC \
-fp-model precise"

export CFLAGS_DBG="\
-O0 \
-g \
-fPIC \
-Wall"


# ============================================================================
# C++ compiler flags
# ============================================================================

export CXXFLAGS_OPT="\
-O2 \
-g \
-fPIC \
-fp-model precise"

export CXXFLAGS_DBG="\
-O0 \
-g \
-fPIC \
-Wall"


# ============================================================================
# Select C/C++ flags
# ============================================================================

if [[ "${DEBUG}" == "0" ]]; then

    export CFLAGS="${CFLAGS_OPT}"
    export CXXFLAGS="${CXXFLAGS_OPT}"

else

    export CFLAGS="${CFLAGS_DBG}"
    export CXXFLAGS="${CXXFLAGS_DBG}"

fi


# ============================================================================
# Fortran preprocessing
# ============================================================================

export FPP="-fpp"
export CPP="-cpp"
export MFLAG="-module"


# ============================================================================
# Intel Fortran runtime libraries
# ============================================================================

export L_FLIBS="\
-Wl,-rpath,${FLIBROOT} \
-L${FLIBROOT} \
-lifcore \
-lifport \
-limf \
-lsvml \
-lintlc \
-lm"


# ============================================================================
# C/C++ runtime libraries
# ============================================================================

export L_CLIBS="\
-lstdc++ \
-lm"


# ============================================================================
# Readline and Intel runtime
# ============================================================================

export L_EDIT="\
-L${FLIBROOT} \
-lifport \
-limf \
-lifcore \
-L/usr/lib64 \
-lreadline \
-lhistory \
-lncurses \
-ldl"


# ============================================================================
# Preprocessor definitions
# ============================================================================

export FDEFS="-D__LINUX -D__UNIX -D__F90"

export CDEFS="-D__LINUX"


# ============================================================================
# Default include directories
# ============================================================================

export FINCL=""
export CINCL=""


# ============================================================================
# General linker flags
# ============================================================================

export LDFLAGS=""


# ============================================================================
# Runtime library search paths
# ============================================================================

prepend_ld_library_path()
{
    local dir="$1"

    if [[ -n "${dir}" && -d "${dir}" ]]; then

        case ":${LD_LIBRARY_PATH:-}:" in

            *":${dir}:"*)
                ;;
            *)
                export LD_LIBRARY_PATH="${dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
                ;;
        esac

    fi
}


prepend_ld_library_path "${FLIBROOT}"

if [[ -n "${MPI_HOME:-}" ]]; then
    prepend_ld_library_path "${MPI_HOME}/lib"
    prepend_ld_library_path "${MPI_HOME}/lib64"
fi

prepend_ld_library_path "${NETCDF_F_HOME}/lib"
prepend_ld_library_path "${NETCDF_C_HOME}/lib64"

if [[ -n "${HDF5_HOME:-}" ]]; then
    prepend_ld_library_path "${HDF5_HOME}/lib"
fi

if [[ -n "${SZIP_HOME:-}" ]]; then
    prepend_ld_library_path "${SZIP_HOME}/lib"
fi

prepend_ld_library_path "${PSPLINE_HOME}/lib"
prepend_ld_library_path "${MDSPLUS_DIR}/lib"


# ============================================================================
# Environment summary
# ============================================================================

echo
echo "============================================================"
echo " UFILES environment -- Flux / Intel 2023.2.0"
echo "============================================================"
echo

echo "Compilers:"
echo "  FC              = ${FC}"
echo "  CC              = ${CC}"
echo "  CXX             = ${CXX}"
echo

echo "Compiler locations:"
echo "  FC              = $(command -v "${FC}")"
echo "  CC              = $(command -v "${CC}")"
echo "  CXX             = $(command -v "${CXX}")"
echo "  MPIF90          = $(command -v "${MPIF90}")"
echo

echo "Build:"
echo "  MAKE_SO         = ${MAKE_SO}"
echo "  DEBUG           = ${DEBUG}"
echo

echo "Compiler flags:"
echo "  FFLAGS          = ${FFLAGS}"
echo "  CFLAGS          = ${CFLAGS}"
echo "  CXXFLAGS        = ${CXXFLAGS}"
echo

echo "Libraries:"
echo "  FLIBROOT        = ${FLIBROOT}"
echo "  NETCDF_F_HOME   = ${NETCDF_F_HOME}"
echo "  NETCDF_C_HOME   = ${NETCDF_C_HOME}"
echo "  HDF5_HOME       = ${HDF5_HOME:-not set}"
echo "  SZIP_HOME       = ${SZIP_HOME:-not set}"
echo "  PSPLINE_HOME    = ${PSPLINE_HOME}"
echo "  MDSPLUS_DIR     = ${MDSPLUS_DIR}"
echo

echo "Linker flags:"
echo "  L_NETCDF        = ${L_NETCDF}"
echo "  L_PSPLINE       = ${L_PSPLINE}"
echo "  L_MDSPLUS       = ${L_MDSPLUS}"
echo "  L_FLIBS         = ${L_FLIBS}"
echo "  L_CLIBS         = ${L_CLIBS}"
echo "  L_EDIT          = ${L_EDIT}"
echo

echo "============================================================"
