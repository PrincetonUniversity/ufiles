module purge

module load pgi/20.4/64
export FLIBROOT=$(echo $LD_LIBRARY_PATH | sed 's/:.*//')
export F90HOME=$PGI/linuxpower/20.4

export FC=pgf90
export CC=pgcc18
export CX=pgc++


export FTN_MAIN=$FLIBROOT/for_main.o
export FTN_TRAILER="-L$FLIBROOT -lifport -lintlc -limf -lifcore -ldl -lm -lirc -lsvml"
#GCC_PATH=$(gcc -print-file-name=libstdc++.a)
#GCC_DIR=$(dirname $GCC_PATH)
export CPP_TRAILER=" -L/usr/lib64 -lstdc++"

export LOADER_TRAILER=" -L$LOCAL/other -lreadline -lhistory -ltermcap -ldl"

module load netcdf/pgi-20.4/hdf5-1.10.6/4.7.3
export NETCDF_DIR=/usr/local/share/Modules/modulefiles/netcdf/pgi-20.4/hdf5-1.10.6/4.7.3
export L_NETCDF=" -L$NETCDF_DIR/lib64 -lnetcdf -lnetcdff"
#export NETCDF_CCOPTS=" -DNO_NETCDF_2"

module load mdsplus/pppl/stable-7-132-0
export L_MDSPLUS=" -L$MDSPLUS_DIR/lib -lMdsLib"
export TRANSPGRID_SERVER=transpgrid.pppl.gov
export MDS_TRANSP_SERVER=transpgrid.pppl.gov
export MDS_TRANSP_RETRY=3

