module purge

module load gcc/8
export FLIBROOT=$(echo $LD_LIBRARY_PATH | sed 's/:.*//')
export F90HOME=$GCC_HOME
export GCCVERSION=`gcc -dumpversion | cut -f1 -d.`

export FC=gfortran
export CC=gcc
export CX=g++

export FTN_MAIN=""
export FTN_TRAILER=" -L$FLIBROOT -lgfortran"
export CPP_TRAILER=" -L$FLIBROOT -lstdc++ -lgcc_s -lgcc"

export LOADER_TRAILER=" -L$LOCAL/other -lreadline -lhistory -ltermcap -ldl"

module load netcdf/gcc/hdf5-1.10.6/4.7.3
#module load szip/2.1.1
export L_NETCDF=" -L$NETCDFDIR/lib -lnetcdff -L$NETCDFDIR/lib -lnetcdf"
export NETCDFHOME=$NETCDFDIR

export PSPLINE_HOME=/projects/TRANSP/opt/pspline/2.0.1/gnu/8.5.0
export L_PSPLINE=" -L$PSPLINE_HOME/lib -lpspline"

module load mdsplus/pppl/stable-7-132-0
export L_MDSPLUS=" -L$MDSPLUS_DIR/lib -lMdsLib -lMdsShr -lMdsIpShr -lTdiShr -lTreeShr"
export TRANSPGRID_SERVER=transpgrid.pppl.gov
export MDS_TRANSP_SERVER=transpgrid.pppl.gov
export MDS_TRANSP_RETRY=3
