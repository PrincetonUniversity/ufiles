export PREFIX=${UFILES_HOME}/gcc/`gcc -dumpversion`

module purge
module load PrgEnv-gnu/8.5.0
module load gcc-native/13.2 
module load cray-hdf5/1.14.3.1
module load cray-netcdf/4.9.0.13 

export SOFT_HOME=/global/cfs/projectdirs/m4497/software

export FC=gfortran
export CC=gcc
export CXX=g++
export GCCVERSION=`gcc -dumpversion | cut -f1 -d.`

export FTN_MAIN=""
export FTN_TRAILER=" -L$FLIBROOT -lgfortran"
export CPP_TRAILER=" -L$FLIBROOT -lstdc++ -lgcc_s -lgcc"

export LOADER_TRAILER=" -L$LOCAL/other -lreadline -lhistory -ltinfo -ldl"

# NETCDF
export L_NETCDF=`pkg-config --libs netcdf`
export L_NETCDF+=" `pkg-config --libs netcdf-fortran` "
export NETCDF_FORTRAN_HOME=$NETCDF_DIR

export MDSPLUS_DIR=$SOFT_HOME/mdsplus
export L_MDSPLUS=" -L$MDSPLUS_DIR/lib -lMdsLib -lTreeShr"
export LD_LIBRARY_PATH=$MDSPLUS_DIR/lib:$LD_LIBRARY_PATH
export TRANSPGRID_SERVER=transpgrid.pppl.gov
export MDS_TRANSP_SERVER=transpgrid.pppl.gov
export MDS_TRANSP_RETRY=3

# PSPLINE
export PSPLINE_HOME=$SOFT_HOME/pspline
export L_PSPLINE=" -L$PSPLINE_HOME/lib -lpspline"
