module purge

module load git

module load gcc/9.3.0
export FLIBROOT=$(echo $LD_LIBRARY_PATH | sed 's/:.*//')
export F90HOME=$GCC_HOME

export FC=gfortran
export CC=gcc
export CX=g++

export FTN_MAIN=""
export FTN_TRAILER=" -L$FLIBROOT -lgfortran"
export CPP_TRAILER=" -L$FLIBROOT -lstdc++ -lgcc_s -lgcc"

export LOADER_TRAILER=" -L$LOCAL/other -lreadline -lhistory -ltermcap -ldl"

module load netcdf-c/4.7.3
module load szip/2.1.1
module load netcdf-fortran/4.5.2
export L_NETCDF=" -L$NETCDF_FORTRAN_HOME/lib -lnetcdff -L$NETCDF_C_HOME/lib -lnetcdf"
export NETCDFHOME=$NETCDF_FORTRAN_HOME

module load mdsplus
export L_MDSPLUS=" -L$MDSPLUS_DIR/lib -lMdsLib"
export TRANSPGRID_SERVER=transpgrid.pppl.gov
export MDS_TRANSP_SERVER=transpgrid.pppl.gov
export MDS_TRANSP_RETRY=3
