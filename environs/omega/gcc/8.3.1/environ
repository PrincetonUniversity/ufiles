module purge

module load env/gcc8.x
export FLIBROOT=$LIBS_DIR

export FC=gfortran
export CC=gcc
export CX=g++

export FTN_MAIN=""
export FTN_TRAILER=" -L$FLIBROOT -lgfortran"
