# This is an environment to be sourced in the repository root.
#
# It is structured by site, then by compiler-specific environments.
#

export UFILES_HOME=$(pwd)
export MPI_ENABLE=1

# ----------------------------------------------------------------------
# Site
# ----------------------------------------------------------------------

if [ -n "$SITE" ]; then
    echo "Provided \$SITE=${SITE}"
    SITE_ENV=${SITE}
else
    echo -n "\$SITE not provided. Attempting site discovery using hostname and dnsdomainname. "

    # Query hostname and dnsdomainname without failing.
    if command -v hostname >/dev/null 2>&1; then
        HOSTNAME=$(hostname -s)
    else
        HOSTNAME="NA"
    fi

    if command -v dnsdomainname >/dev/null 2>&1; then
        DNSDOMAIN=$(dnsdomainname)
    else
        DNSDOMAIN="NA"
    fi

    if [ -z "$HOSTNAME" ]; then
        HOSTNAME="NA"
    fi

    if [ -z "$DNSDOMAIN" ]; then
        DNSDOMAIN="NA"
    fi

    #
    # Check PPPL HPC systems first.
    # Do not depend on dnsdomainname for these systems.
    #
    if [[ "$HOSTNAME" == flux* ]]; then
        SITE_ENV='ppplflux'

    elif [[ "$HOSTNAME" == lynx* ]]; then
        SITE_ENV='pppllynx'

    elif [[ "$HOSTNAME" == ranger* ]]; then
        SITE_ENV='ppplranger'

    #
    # Other PPPL systems
    #
    elif [[ "$DNSDOMAIN" == "pppl.gov" ]]; then
        SITE_ENV='pppl'

    #
    # Other sites
    #
    elif [[ "$HOSTNAME" == "stellar-intel" ]]; then
        SITE_ENV='stellar'

    elif [[ "$DNSDOMAIN" == "ornl.gov" ]]; then
        SITE_ENV='ornl'

    elif [[ "$DNSDOMAIN" == "iter.org" ]]; then
        SITE_ENV='iter'

    elif [[ "${LMOD_SITE_NAME:-}" == NERSC* ]]; then
        SITE_ENV='perlmutter'

    elif [[ "$HOSTNAME" == iris* ]]; then
        SITE_ENV='iris'

    elif [[ "$HOSTNAME" == omega* ]]; then
        SITE_ENV='omega'

    elif [[ "$HOSTNAME" == mfews* ]]; then
        SITE_ENV='psfc'

    else
        echo
        echo "\$SITE not provided; defaulting SITE='generic'"
        SITE_ENV='generic'
    fi

    echo "Found SITE ${SITE_ENV}"
fi


# ----------------------------------------------------------------------
# Compiler
# ----------------------------------------------------------------------

if [ -n "$COMPILER" ]; then
    echo "Provided \$COMPILER=${COMPILER}"
else
    # When compiler is not provided, use the site default.
    case "$SITE_ENV" in
        pppl)
            COMPILER='ICC'
            ;;
        ppplflux|pppllynx|ppplranger)
            COMPILER='GCC'
            ;;
        perlmutter)
            COMPILER='GCC'
            ;;
        stellar|iris)
            COMPILER='ICC'
            ;;
        omega|psfc)
            COMPILER='GCC'
            ;;
        *)
            COMPILER='GCC'
            ;;
    esac

    echo "\$COMPILER not provided, assuming default ${COMPILER} for \$SITE=${SITE_ENV}"
fi

export COMPILER


# ----------------------------------------------------------------------
# Determine compiler family
# ----------------------------------------------------------------------

case "$COMPILER" in
    PGC|PGI|Portland)
        COMPILER_ENV='pgi'
        ;;
    GCC)
        COMPILER_ENV='gcc'
        ;;
    ICC)
        COMPILER_ENV='intel'
        ;;
    NVIDIA)
        COMPILER_ENV='nvidia'
        ;;
    *)
        echo "ERROR: $COMPILER compiler not supported"
        return 1
        ;;
esac


# ----------------------------------------------------------------------
# Determine compiler version
# ----------------------------------------------------------------------

if [ -n "$COMPILER_VER" ]; then
    echo "Provided ${COMPILER_ENV} Version ${COMPILER_VER}"
else

    # Map "SITE_ENV,COMPILER_ENV" -> default compiler version.
    #
    # NOTE:
    # Associative arrays require Bash 4 or newer.

    declare -A version_map

    version_map["pppl,gcc"]='9.3.0'
    version_map["pppl,pgi"]='19.10'
    version_map["pppl,intel"]='2019'

    version_map["iter,gcc"]='10.2.0'

    version_map["ppplflux,intel"]='2023'
    version_map["ppplflux,gcc"]='13.2.0'

    version_map["pppllynx,gcc"]='13.4.0'

    version_map["ppplranger,gcc"]='13.3.0'

    version_map["perlmutter,nvidia"]='22.7'
    version_map["perlmutter,gcc"]='13.2'

    version_map["stellar,intel"]='2021'
    version_map["iris,intel"]='2018'

    version_map["omega,gcc"]='8.3.1'
    version_map["psfc,gcc"]='7.5.0'

    version_map["generic,gcc"]='0.0.0'

    version_map["yournewsite,somecompiler"]='versionthatfixesallthebugsinyourcode'

    KEY="${SITE_ENV},${COMPILER_ENV}"
    COMPILER_VER=${version_map["$KEY"]}

    if [ -z "$COMPILER_VER" ]; then
        echo "ERROR: Default compiler version is not defined for ${KEY}."
        echo "Please provide COMPILER_VER or extend version_map."
        return 1
    fi
fi


# ----------------------------------------------------------------------
# Information used by the test harness to reconstruct the environment
# inside Slurm jobs
# ----------------------------------------------------------------------

export _COMPILER="${COMPILER}"
export _COMPILER_VER="${COMPILER_VER}"
export SITE_ENV

export COMPILER_FLAGS="${UFILES_HOME}/environs/${SITE_ENV}/${COMPILER_ENV}/${COMPILER_VER}/makefile.mk"


# ----------------------------------------------------------------------
# Load compiler/site-specific environment
# ----------------------------------------------------------------------

export ENV_FILE="${UFILES_HOME}/environs/${SITE_ENV}/${COMPILER_ENV}/${COMPILER_VER}/environ"

if [ -f "$ENV_FILE" ]; then
    echo "Using ENV_FILE=${ENV_FILE}"
else
    echo "ERROR: ENV_FILE=${ENV_FILE} does not exist."
    echo "Please check SITE, COMPILER_ENV, and COMPILER_VER."
    echo "If they are correct, you will need to add this environ file."
    return 1
fi

source "$ENV_FILE"


# ----------------------------------------------------------------------
# Installation prefix
# ----------------------------------------------------------------------

# Reset compiler version so LOCAL/PREFIX is set correctly for generic GCC.
if [ "$SITE_ENV" = 'generic' ]; then
    COMPILER_VER=$(gcc -dumpversion)
fi

export PREFIX="${UFILES_HOME}/builds/${COMPILER_ENV}/${COMPILER_VER}"

mkdir -p "$PREFIX"/{bin,include,lib,mod,mpi_mod,obj}

export PATH="${PREFIX}/bin:${PATH}"

echo "Using PREFIX=${PREFIX}"

export OBJDIR="${PREFIX}/obj"


# ----------------------------------------------------------------------
# Clean temporary environment-selection variables for idempotence
# ----------------------------------------------------------------------
unset SITE
unset COMPILER
unset COMPILER_ENV
unset COMPILER_VER