;CONCAT TOP NODE: ENTER OPCODE$
*T ==> "concat" combines 1d Ufiles f(x) sorted by a keyword scalar value,
*T     to form a 2d Ufile e.g. f(x,t).  Additional profiles can be 
*T     specified by interpolation or extrapolation
;CONCAT TOP NODE: ENTER OPCODE$
R
;CONCAT: SELECT MODE OF INPUT (1 OR 2):$
2
;UFNTER:  ENTER OPCODE (D/E/F/P/S/Q... ):$
H ECE PR1 Q
;UFGKEY:  ENTER SCALAR IDENTIFICATION KEYWORD (MAX 9 CHARS):$
T0
;UFNTER:  ENTER OPCODE (D/E/F/P/S/Q... ):$
H ECE OUT Q
;TV2OUT:  ENTER 5 DIGIT SHOT # FOR NAMING DATA FILES:$
37065
;CONCAT TOP NODE: ENTER OPCODE$
F
;TVGETM(CONCAT):  ENTER MODE 2 INPUT OPCODE:$
I
;TVGETM:  SPECIFY FILENAME .EXT (3 CHARS):$
PR1
;TVGETM(CONCAT):  ENTER MODE 2 INPUT OPCODE:$
I PR2
;TVGETM(CONCAT):  ENTER MODE 2 INPUT OPCODE:$
I PR3
;TVGETM(CONCAT):  ENTER MODE 2 INPUT OPCODE:$
I PR4
;TVGETM(CONCAT):  ENTER MODE 2 INPUT OPCODE:$
P
;TVGETM(CONCAT):  ENTER MODE 2 INPUT OPCODE:$
Q
;CONCAT TOP NODE: ENTER OPCODE$
G
;TV1GRF:  ENTER 3 CHARACTER FILENAME EXTENSION:$
PR1 N
;TV1GRF:  ENTER 3 CHARACTER FILENAME EXTENSION:$
PR2 N
;TV1GRF:  ENTER 3 CHARACTER FILENAME EXTENSION:$
PR3 N
;TV1GRF:  ENTER 3 CHARACTER FILENAME EXTENSION:$
PR4 N
;TV1GRF:  ENTER 3 CHARACTER FILENAME EXTENSION:$
Q
;CONCAT TOP NODE: ENTER OPCODE$
*T  (the concatenated profiles are plotted)
P 1 P
;GRF3SG:  SELECT 3D ISOMETRIC AXIS OPTION (X/Y/Z/D/P):$
Q
; GRF3SG:  ENTER OPTION #:$
4
;CONCAT TOP NODE: ENTER OPCODE$
I
;TVTINS:  ENTER OPCODE:$
I
;TVTINS:  ENTER Y VALUE FOR EXTRA PROFILE: (E10 FORMAT):$
0.5
;TVTINS:  ENTER WEIGHTING FACTOR W (BETWEEN 0 AND 1):$
0.1
;TVTINS:  ENTER OPCODE:$
I
;TVTINS:  ENTER Y VALUE FOR EXTRA PROFILE: (E10 FORMAT):$
5.5
;TVTINS:  ENTER WEIGHTING FACTOR W (BETWEEN 0 AND 1):$
0.9
;TVTINS:  ENTER OPCODE:$
X
;CONCAT TOP NODE: ENTER OPCODE$
P
; GRF3SG:  ENTER OPTION #:$
*T  (extrapolated profiles are added at t=0.5 and t=5.5 seconds)
1 P
;GRF3SG:  SELECT 3D ISOMETRIC AXIS OPTION (X/Y/Z/D/P):$
Q
; GRF3SG:  ENTER OPTION #:$
Q
;CONCAT TOP NODE: ENTER OPCODE$
X
